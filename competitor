            document.getElementById('sort_growth').className = sortKey === 'growth'
                ? 'px-3 py-1.5 rounded-md font-bold bg-white text-slate-900 shadow-xs transition'
                : 'px-3 py-1.5 rounded-md font-medium text-slate-600 hover:text-slate-900 transition';
            updateDashboard();
        }

        function changeViewMode(mode) {
            currentViewMode = mode;
            document.getElementById('view_card').className = mode === 'card'
                ? 'px-3 py-1.5 rounded-md font-bold bg-white text-slate-900 shadow-xs transition flex items-center gap-1.5'
                : 'px-3 py-1.5 rounded-md font-medium text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
            document.getElementById('view_table').className = mode === 'table'
                ? 'px-3 py-1.5 rounded-md font-bold bg-white text-slate-900 shadow-xs transition flex items-center gap-1.5'
                : 'px-3 py-1.5 rounded-md font-medium text-slate-600 hover:text-slate-900 transition flex items-center gap-1.5';
            updateDashboard();
        }

        function openHelpModal() {
            document.getElementById('helpModal').classList.remove('hidden');
        }

        function closeHelpModal() {
            document.getElementById('helpModal').classList.add('hidden');
        }

        function renderMonthlyChart(storeObj, brandName) {
            const container = document.getElementById('monthlyChartContainer');
            const labelEl = document.getElementById('chartBrandLabel');
            if (!container) return;

            if (labelEl) {
                labelEl.innerText = `${brandName} 월별 추이 (막대 클릭 시 월별 조회)`;
            }

            const count = Math.max(1, maxMonthWithData);
            container.style.gridTemplateColumns = `repeat(${count}, minmax(0, 1fr))`;

            const months = [];
            let maxVal = 1;
            for (let m = 1; m <= count; m++) {
                const v26 = (storeObj.sales_26 && storeObj.sales_26[`m${m}`] && storeObj.sales_26[`m${m}`][brandName]) || 0;
                const v25 = (storeObj.sales_25 && storeObj.sales_25[`m${m}`] && storeObj.sales_25[`m${m}`][brandName]) || 0;
                if (v26 > maxVal) maxVal = v26;
                if (v25 > maxVal) maxVal = v25;
                months.push({ m, v26, v25 });
            }

            container.innerHTML = months.map(({ m, v26, v25 }) => {
                const pKey = `m${m}`;
                const isSelected = currentPeriod === pKey;
                // 차트 높이를 h-24에 맞춰 스케일 업 (최대 높이 약 64px)
                const h25 = v25 > 0 ? Math.max(8, Math.round((v25 / maxVal) * 64)) : 2;
                const h26 = v26 > 0 ? Math.max(8, Math.round((v26 / maxVal) * 64)) : 2;
                const nextPeriod = isSelected ? 'accum' : pKey;
                const colHighlight = isSelected
                    ? 'bg-white/15 ring-1 ring-emerald-400/60'
                    : 'hover:bg-white/10';
                const labelCls = isSelected ? 'text-emerald-300 font-extrabold' : 'text-white/65 font-medium';

                return `
                    <button type="button" onclick="changePeriod('${nextPeriod}')" title="${m}월 · 26년 ${formatSales(v26)} / 25년 ${formatSales(v25)}" class="flex flex-col items-center justify-end h-full rounded-lg px-0.5 py-1 transition cursor-pointer ${colHighlight}">
                        <div class="flex items-end justify-center gap-0.5 h-16 w-full">
                            <span class="w-1.5 lg:w-2 rounded-t-xs bg-white/30 transition-all duration-300" style="height: ${h25}px;"></span>
                            <span class="w-1.5 lg:w-2 rounded-t-xs ${isSelected ? 'bg-amber-300' : 'bg-emerald-400'} transition-all duration-300" style="height: ${h26}px;"></span>
                        </div>
                        <span class="text-[10px] mt-1.5 leading-none tabular-nums ${labelCls}">${m}월</span>
                    </button>
                `;
            }).join('');
        }

        function updateDashboard() {
            const listEl = document.getElementById('brandListContainer');
            const branchData = getBranchFilteredData();

            if (branchData.length === 0 && !document.getElementById('storeSearchInput').value.trim()) {
                listEl.className = 'w-full';
                listEl.innerHTML = `
                    <div class="bg-white p-10 rounded-2xl border border-slate-200 text-center space-y-3">
                        <i class="fa-solid fa-spinner fa-spin text-3xl text-indigo-400"></i>
                        <p class="text-sm font-bold text-slate-600">데이터를 불러오는 중이거나 매장이 없습니다.</p>
                    </div>`;
                return;
            }

            const storeObj = RAW_STORE_DATA.find(d => d.store === currentStore) || branchData[0] || RAW_STORE_DATA[0];
            if (!storeObj) return;

            const branch = storeObj.branch;
            renderRegionPills();

            const p26 = (storeObj.sales_26 && storeObj.sales_26[currentPeriod]) || {};
            const p25 = (storeObj.sales_25 && storeObj.sales_25[currentPeriod]) || {};
            const acc26 = (storeObj.sales_26 && storeObj.sales_26.accum) || {};
            const acc25 = (storeObj.sales_25 && storeObj.sales_25.accum) || {};

            document.getElementById('headerSubtitle').innerText = `${storeObj.branchName} · ${storeObj.region} · ${storeObj.store} · ${PERIOD_NAMES[currentPeriod]}`;
            document.getElementById('cardBranchBadge').innerText = storeObj.branchName;

            const selectedMonth = currentPeriod !== 'accum' ? parseInt(currentPeriod.replace('m', ''), 10) : maxMonthWithData;

            const salesSortedList = Object.entries(p26)
                .filter(([_, v]) => v > 0)
                .map(([brand, val26]) => {
                    const val25 = p25[brand] || 0;
                    const growth = val25 > 0 ? ((val26 - val25) / val25) * 100 : null;
                    const close25 = (storeObj.sales_25_close && storeObj.sales_25_close[brand])
                        || (acc25 && acc25[brand])
                        || 0;

                    let ytd26 = 0;
                    if (currentPeriod === 'accum' || selectedMonth === maxMonthWithData) {
                        ytd26 = acc26[brand] || 0;
                        if (ytd26 === 0) {
                            for (let m = 1; m <= selectedMonth; m++) {
                                ytd26 += (storeObj.sales_26 && storeObj.sales_26[`m${m}`] && storeObj.sales_26[`m${m}`][brand]) || 0;
                            }
                        }
                    } else {
                        for (let m = 1; m <= selectedMonth; m++) {
                            ytd26 += (storeObj.sales_26 && storeObj.sales_26[`m${m}`] && storeObj.sales_26[`m${m}`][brand]) || 0;
                        }
                    }

                    return { brand, val26, val25, close25, ytd26, growth };
                })
                .sort((a, b) => b.val26 - a.val26);

            const totalDistrictSales = salesSortedList.reduce((sum, item) => sum + item.val26, 0);
            const topBrandSales = salesSortedList.length > 0 ? salesSortedList[0].val26 : 1;

            salesSortedList.forEach((item, idx) => {
                item.salesRank = idx + 1;
                item.share = totalDistrictSales > 0 ? (item.val26 / totalDistrictSales) * 100 : 0;
            });

            let focusBrand = null;
            for (const pBrand of FOCUS_BRAND_PRIORITY) {
                const found = salesSortedList.find(b => b.brand === pBrand);
                if (found) {
                    focusBrand = found;
                    break;
                }
            }
            if (!focusBrand) {
                focusBrand = salesSortedList[0] || { brand: '웰메이드', val26: 0, val25: 0, close25: 0, growth: null, salesRank: 0, share: 0 };
            }

            const hasWellmade = focusBrand.brand === '웰메이드';
            applyThemeColor(branch, hasWellmade);

            const popText = storeObj.pop ? ` · 인구 ${storeObj.pop}` : '';
            document.getElementById('cardRegionInfo').innerText = `${storeObj.region}${popText} · ${focusBrand.brand} 기준`;
            document.getElementById('cardStoreName').innerText = storeObj.store;
            document.getElementById('cardStoreRank').innerText = focusBrand.salesRank > 0
                ? `상권 ${focusBrand.salesRank}위 / ${salesSortedList.length}개`
                : '실적 없음';
            document.getElementById('cardTopShareBadge').innerText = `점유율 ${focusBrand.share.toFixed(1)}%`;

            const focusClose25 = (storeObj.sales_25_close && storeObj.sales_25_close[focusBrand.brand])
                || (acc25 && acc25[focusBrand.brand])
                || focusBrand.close25
                || 0;
            document.getElementById('cardShareBadge').innerText = formatToEok(focusClose25);

            document.getElementById('shareBarPercent').innerText = `${focusBrand.share.toFixed(1)}%`;
            document.getElementById('shareBarTotal').innerText = formatSales(totalDistrictSales);
            document.getElementById('shareBarFill').style.width = `${Math.min(100, Math.max(0, focusBrand.share)).toFixed(1)}%`;

            const accVal26 = acc26[focusBrand.brand] || 0;
            const accVal25 = acc25[focusBrand.brand] || 0;
            const accGrowth = accVal25 > 0 ? (((accVal26 - accVal25) / accVal25) * 100).toFixed(1) : null;

            document.getElementById('cardMetric1Label').innerText = `26년 누계 (${focusBrand.brand})`;
            document.getElementById('cardMetric1Value').innerText = formatSales(accVal26);
            if (accGrowth !== null) {
                const sign = parseFloat(accGrowth) > 0 ? '▲ +' : (parseFloat(accGrowth) < 0 ? '▼ ' : '');
                document.getElementById('cardGrowth1Badge').innerText = `${sign}${accGrowth}%`;
                document.getElementById('cardGrowth1Badge').className = parseFloat(accGrowth) >= 0 ? 'text-[11px] font-bold text-emerald-400 tabular-nums' : 'text-[11px] font-bold text-rose-400 tabular-nums';
                document.getElementById('cardPrev1Label').innerText = `(전년 ${formatSales(accVal25)})`;
            } else {
                document.getElementById('cardGrowth1Badge').innerText = '-';
                document.getElementById('cardPrev1Label').innerText = '(전년 없음)';
            }

            if (currentPeriod === 'accum') {
                const avg26 = Math.round(accVal26 / Math.max(1, maxMonthWithData));
                const avg25 = Math.round(accVal25 / Math.max(1, maxMonthWithData));
                document.getElementById('cardMetric2Label').innerText = `월평균 매출 (1~${maxMonthWithData}월)`;
                document.getElementById('cardMetric2Value').innerText = formatSales(avg26);
                if (accGrowth !== null) {
                    const sign = parseFloat(accGrowth) > 0 ? '▲ +' : (parseFloat(accGrowth) < 0 ? '▼ ' : '');
                    document.getElementById('cardGrowth2Badge').innerText = `${sign}${accGrowth}%`;
                    document.getElementById('cardGrowth2Badge').className = parseFloat(accGrowth) >= 0 ? 'text-[11px] font-bold text-emerald-400 tabular-nums' : 'text-[11px] font-bold text-rose-400 tabular-nums';
                    document.getElementById('cardPrev2Label').innerText = `(전년 ${formatSales(avg25)})`;
                } else {
                    document.getElementById('cardGrowth2Badge').innerText = '-';
                    document.getElementById('cardPrev2Label').innerText = '(전년 없음)';
                }
            } else {
                const mVal26 = focusBrand.val26 || 0;
                const mVal25 = focusBrand.val25 || 0;
                const mGrowth = mVal25 > 0 ? (((mVal26 - mVal25) / mVal25) * 100).toFixed(1) : null;
                document.getElementById('cardMetric2Label').innerText = `${PERIOD_NAMES[currentPeriod]} 실적`;
                document.getElementById('cardMetric2Value').innerText = formatSales(mVal26);
                if (mGrowth !== null) {
                    const sign = parseFloat(mGrowth) > 0 ? '▲ +' : (parseFloat(mGrowth) < 0 ? '▼ ' : '');
                    document.getElementById('cardGrowth2Badge').innerText = `${sign}${mGrowth}%`;
                    document.getElementById('cardGrowth2Badge').className = parseFloat(mGrowth) >= 0 ? 'text-[11px] font-bold text-emerald-400 tabular-nums' : 'text-[11px] font-bold text-rose-400 tabular-nums';
                    document.getElementById('cardPrev2Label').innerText = `(전년 ${formatSales(mVal25)})`;
                } else {
                    document.getElementById('cardGrowth2Badge').innerText = '-';
                    document.getElementById('cardPrev2Label').innerText = '(전년 없음)';
                }
            }

            renderMonthlyChart(storeObj, focusBrand.brand);

            const displayList = [...salesSortedList];
            if (currentSort === 'growth') {
                displayList.sort((a, b) => {
                    const gA = a.growth !== null ? a.growth : -999999;
                    const gB = b.growth !== null ? b.growth : -999999;
                    return gB - gA;
                });
            }

            document.getElementById('brandCountBadge').innerText = `${displayList.length}개`;

            if (displayList.length === 0) {
                listEl.className = 'w-full';
                listEl.innerHTML = `<div class="bg-white p-10 rounded-2xl border border-slate-100 text-center text-sm text-slate-400">집계된 브랜드 매출 데이터가 없습니다.</div>`;
                return;
            }

            // 요약표 모드
            if (currentViewMode === 'table') {
                listEl.className = 'w-full overflow-x-auto';
                const tableRows = displayList.map((item) => {
                    const rankBadge = item.salesRank === 1
                        ? 'bg-amber-500 text-white'
                        : (item.salesRank <= 3 ? 'bg-slate-800 text-white' : 'bg-slate-100 text-slate-700');

                    let growthCell = `<span class="text-xs text-slate-400">-</span>`;
                    if (item.growth !== null) {
                        const sign = item.growth > 0 ? '+' : '';
                        const cls = item.growth >= 0 ? 'text-emerald-600 bg-emerald-50' : 'text-rose-600 bg-rose-50';
                        const arrow = item.growth >= 0 ? '▲' : '▼';
                        growthCell = `<span class="inline-block px-2 py-1 rounded text-xs font-bold tabular-nums ${cls}">${arrow} ${sign}${item.growth.toFixed(1)}%</span>`;
                    }

                    return `
                        <tr class="border-b border-slate-100 last:border-b-0 hover:bg-slate-50/80 transition">
                            <td class="py-3 pl-4 pr-2 text-center w-14">
                                <span class="inline-flex items-center justify-center w-7 h-7 rounded-lg text-xs font-extrabold ${rankBadge}">${item.salesRank}</span>
                            </td>
                            <td class="py-3 px-2">
                                <div class="text-sm font-bold text-slate-900">${item.brand}</div>
                                <div class="text-xs text-slate-400 tabular-nums mt-0.5">${formatToEok(item.close25)} · 점유 ${item.share.toFixed(1)}%</div>
                            </td>
                            <td class="py-3 px-2 text-right text-sm font-extrabold text-slate-900 tabular-nums whitespace-nowrap">
                                ${formatSales(item.val26)}
                                <div class="text-[11px] text-slate-400 font-normal mt-0.5">25년 매출 ${item.val25 > 0 ? formatSales(item.val25) : '-'}</div>
                                ${currentPeriod !== 'accum' ? `<div class="text-[11px] text-slate-500 font-medium">${selectedMonth}월 누계 ${formatSales(item.ytd26)}</div>` : ''}
                            </td>
                            <td class="py-3 pl-2 pr-4 text-right whitespace-nowrap">${growthCell}</td>
                        </tr>
                    `;
                }).join('');

                listEl.innerHTML = `
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden min-w-[500px]">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-slate-50 border-b border-slate-200/70 text-xs font-bold text-slate-500">
                                    <th class="py-2.5 pl-4 pr-2 text-center w-14">순위</th>
                                    <th class="py-2.5 px-2">브랜드</th>
                                    <th class="py-2.5 px-2 text-right">26년 실적</th>
                                    <th class="py-2.5 pl-2 pr-4 text-right">신장률</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${tableRows}
                            </tbody>
                        </table>
                    </div>
                `;
                return;
            }

            // 카드 보기 모드 (PC 레이아웃 연동 Grid 활성화)
            listEl.className = 'grid grid-cols-1 md:grid-cols-2 xl:grid-cols-2 gap-4 lg:gap-5';
            listEl.innerHTML = displayList.map((item) => {
                const rank = item.salesRank;
                const rankBadgeCls = rank === 1
                    ? 'bg-amber-500 text-white shadow-amber-200/60'
                    : (rank <= 3 ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700');

                const barColorCls = rank === 1
                    ? 'bg-amber-400'
                    : (branch === 'gangwon' ? 'bg-teal-500' : (branch === 'gyeonggi' ? 'bg-blue-500' : 'bg-indigo-500'));

                const barWidthPct = topBrandSales > 0 ? Math.max(4, Math.round((item.val26 / topBrandSales) * 100)) : 0;

                let growthHtml = `<span class="inline-block text-[11px] lg:text-xs text-slate-400 bg-slate-100 px-2 py-1 rounded-md font-medium">전년 미집계</span>`;
                if (item.growth !== null) {
                    const sign = item.growth > 0 ? '+' : '';
                    const pillCls = item.growth >= 0
                        ? 'text-emerald-700 bg-emerald-50 border-emerald-200/60'
                        : 'text-rose-700 bg-rose-50 border-rose-200/60';
                    const arrow = item.growth >= 0 ? '▲' : '▼';
                    growthHtml = `<span class="inline-block ${pillCls} border text-[11px] lg:text-xs font-bold px-2 py-1 rounded-md tabular-nums">${arrow} ${sign}${item.growth.toFixed(1)}%</span>`;
                }

                const brandAcc26 = acc26[item.brand] || item.val26;
                const monthlyAvg = Math.round(brandAcc26 / Math.max(1, maxMonthWithData));
                const ytdLabel = `${selectedMonth}월 누계`;

                return `
                    <div class="bg-white p-4 lg:p-5 rounded-2xl border border-slate-200/80 shadow-xs hover:shadow-md transition">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center space-x-3.5 min-w-0">
                                <div class="w-11 h-11 rounded-xl ${rankBadgeCls} font-extrabold flex-shrink-0 flex items-center justify-center text-sm shadow-sm">
                                    ${rank}위
                                </div>
                                <div class="min-w-0">
                                    <h4 class="text-base font-extrabold text-slate-900 truncate">${item.brand}</h4>
                                    <p class="text-xs text-slate-400 mt-1 tabular-nums truncate">
                                        ${formatToEok(item.close25)} · 점유 ${item.share.toFixed(1)}%
                                    </p>
                                </div>
                            </div>
                            <div class="text-right flex-shrink-0">
                                <div class="text-lg font-extrabold text-slate-900 tabular-nums">${formatSales(item.val26)}</div>
                                <div class="mt-1.5">${growthHtml}</div>
                            </div>
                        </div>

                        <!-- 상권 1위 대비 상대 매출 가로 막대 -->
                        <div class="mt-4 w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                            <div class="h-full ${barColorCls} rounded-full transition-all duration-500" style="width: ${barWidthPct}%;"></div>
                        </div>

                        <!-- 하단 세부 수치: 25년 매출 & 1~선택월 누계 & 월평균 -->
                        <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between flex-wrap gap-2 text-[11px] lg:text-xs text-slate-500 tabular-nums">
                            <span>25년 매출: <strong class="text-slate-700 font-bold">${item.val25 > 0 ? formatSales(item.val25) : '-'}</strong></span>
                            <div class="flex items-center gap-2 text-slate-400">
                                ${currentPeriod !== 'accum' ? `<span>${ytdLabel} <strong class="text-slate-700 font-semibold">${formatSales(item.ytd26)}</strong></span><span>·</span>` : ''}
                                <span>월평균 <strong class="text-slate-700 font-semibold">${formatSales(monthlyAvg)}</strong></span>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function showToast(msg) {
            const toast = document.getElementById('toastBox');
            if (!toast) return;
            document.getElementById('toastMessage').innerText = msg;
            toast.classList.remove('opacity-0');
            toast.classList.add('opacity-100');
            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0');
            }, 2500);
        }

        window.addEventListener('DOMContentLoaded', () => {
            renderPeriodUI();
            loadGoogleSheetData();
        });
    </script>

</body>
</html>
