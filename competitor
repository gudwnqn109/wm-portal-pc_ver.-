        window.handleGoogleSheetJSONP = function(response) {
            try {
                if (!response || !response.table || !response.table.rows) {
                    showToast("구글 시트 데이터 형식이 올바르지 않습니다.");
                    return;
                }

                const rows = response.table.rows;
                const storeMap = {};

                for (let i = 0; i < rows.length; i++) {
                    const cells = rows[i].c || [];
                    const getVal = (idx) => (cells[idx] && cells[idx].v !== null && cells[idx].v !== undefined) ? cells[idx].v : '';

                    const branchRaw = String(getVal(0)).trim();
                    const region = String(getVal(1)).trim();
                    const pop = String(getVal(2)).trim();
                    const store = String(getVal(3)).trim();
                    const brand = String(getVal(4)).trim();
                    const yearRaw = String(getVal(5)).trim();

                    if (!store || !brand || store === '매장명' || brand === '브랜드') continue;

                    let branch = 'seoul';
                    let branchName = '서울지점';
                    if (branchRaw.includes('경기')) {
                        branch = 'gyeonggi';
                        branchName = '경기지점';
                    } else if (branchRaw.includes('강원')) {
                        branch = 'gangwon';
                        branchName = '강원지점';
                    }

                    const key = `${branch}_${region}_${store}`;
                    if (!storeMap[key]) {
                        storeMap[key] = {
                            region,
                            pop,
                            store,
                            branch,
                            branchName,
                            sales_26: { accum: {} },
                            sales_25: { accum: {} },
                            sales_25_close: {}
                        };
                        for (let m = 1; m <= 12; m++) {
                            storeMap[key].sales_26[`m${m}`] = {};
                            storeMap[key].sales_25[`m${m}`] = {};
                        }
                    }

                    const is26 = yearRaw.includes('26');
                    const target = is26 ? storeMap[key].sales_26 : storeMap[key].sales_25;

                    let sumM = 0;
                    for (let m = 1; m <= 12; m++) {
                        const val = getVal(5 + m);
                        if (val !== '' && !isNaN(val)) {
                            const num = parseFloat(val);
                            if (num !== 0) {
                                target[`m${m}`][brand] = Math.round(num * 10) / 10;
                                sumM += num;
                            }
                        }
                    }

                    const accVal = getVal(18);
                    if (accVal !== '' && !isNaN(accVal)) {
                        target.accum[brand] = Math.round(parseFloat(accVal) * 10) / 10;
                    } else if (sumM > 0) {
                        target.accum[brand] = Math.round(sumM * 10) / 10;
                    }

                    const closeColVal = getVal(19);
                    if (closeColVal !== '' && !isNaN(closeColVal) && parseFloat(closeColVal) > 0) {
                        storeMap[key].sales_25_close[brand] = Math.round(parseFloat(closeColVal) * 10) / 10;
                    } else if (!is26) {
                        const closeBase = (accVal !== '' && !isNaN(accVal)) ? parseFloat(accVal) : sumM;
                        if (closeBase > 0 && !storeMap[key].sales_25_close[brand]) {
                            storeMap[key].sales_25_close[brand] = Math.round(closeBase * 10) / 10;
                        }
                    }
                }

                const parsedList = Object.values(storeMap);
                SEOUL_DATA = parsedList.filter(d => d.branch === 'seoul');
                GYEONGGI_DATA = parsedList.filter(d => d.branch === 'gyeonggi');
                GANGWON_DATA = parsedList.filter(d => d.branch === 'gangwon');

                RAW_STORE_DATA = [...SEOUL_DATA, ...GYEONGGI_DATA, ...GANGWON_DATA];
                renderPeriodUI();

                if (RAW_STORE_DATA.length > 0) {
                    currentRegion = '전체 지역';
                    currentStore = RAW_STORE_DATA[0].store;
                    updateBranchTabUI();
                    renderRegionPills();
                    renderStoreChips();
                    updateDashboard();
                    showToast(`연동 완료! 총 ${RAW_STORE_DATA.length}개 매장 데이터가 로드되었습니다.`);
                } else {
                    showToast("구글 시트에 유효한 매장 데이터가 없습니다.");
                }
            } catch (err) {
                console.error("데이터 처리 오류:", err);
                showToast("데이터 분석 중 오류가 발생했습니다.");
            }
        };

