            m1: '2026년 1월', m2: '2026년 2월', m3: '2026년 3월',
            m4: '2026년 4월', m5: '2026년 5월', m6: '2026년 6월',
            m7: '2026년 7월', m8: '2026년 8월', m9: '2026년 9월',
            m10: '2026년 10월', m11: '2026년 11월', m12: '2026년 12월'
        };

        let maxMonthWithData = 10;

        // 천원 단위 매출을 깔끔한 천 단위 콤마 숫자로 변환
        function formatSales(val) {
            if (val === undefined || val === null || isNaN(val)) return '-';
            return Math.round(val).toLocaleString();
        }

        // 천원 단위 금액을 "25년 마감 0.0억" 형태로 포맷팅
        function formatToEok(val) {
            if (val === undefined || val === null || val === '' || isNaN(val) || Number(val) === 0) {
                return '25년 마감 -';
            }
            const num = parseFloat(val);
            if (num < 1000) {
                return `25년 마감 ${num.toFixed(1)}억`;
            }
            const eok = (num / 100000).toFixed(1);
            return `25년 마감 ${eok}억`;
        }

        // 데이터가 존재하는 마지막 월 자동 감지
        function detectMaxMonth() {
            let maxM = 1;
            for (const store of RAW_STORE_DATA) {
                if (store.sales_26) {
                    for (let m = 1; m <= 12; m++) {
                        const mData = store.sales_26[`m${m}`];
                        if (mData && Object.keys(mData).length > 0) {
                            if (m > maxM) maxM = m;
                        }
                    }
                }
            }
            maxMonthWithData = maxM;
            PERIOD_NAMES.accum = `2026 누계 (1~${maxMonthWithData}월)`;
        }

